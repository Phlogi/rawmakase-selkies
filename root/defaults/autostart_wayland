#!/bin/bash
# Runs inside labwc (Wayland). Selkies copies this to
# /config/.config/labwc/autostart on first run only, so edits made in a running
# session stick.
#
# RAWMAKASE_CLI carries user arguments (a catalog or photo to open, for
# example) without rebuilding the image, the way LinuxServer's browser images
# pass theirs.
exec /usr/bin/rawmakase ${RAWMAKASE_CLI}
